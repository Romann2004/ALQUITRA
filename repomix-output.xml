<div class="dashboard-container">
  <header class="dashboard-header">
    <h1>Resumen del Negocio</h1>
    <p class="subtitle">Monitoreá el estado actual de los trajes y la tendencia de alquileres.</p>
  </header>

  <section class="stats-grid">
    <mat-card class="stat-card total">
      <mat-card-content>
        <div class="card-icon-wrapper">
          <mat-icon>inventory_2</mat-icon>
        </div>
        <div class="card-info">
          <span class="stat-label">Total Trajes</span>
          <h2 class="stat-value">{{ stats.totalTrajes || 0 }}</h2>
        </div>
      </mat-card-content>
    </mat-card>

    <mat-card class="stat-card disponible">
      <mat-card-content>
        <div class="card-icon-wrapper">
          <mat-icon>check_circle</mat-icon>
        </div>
        <div class="card-info">
          <span class="stat-label">Disponibles</span>
          <h2 class="stat-value">{{ stats.disponibles || 0 }}</h2>
        </div>
      </mat-card-content>
    </mat-card>

    <mat-card class="stat-card alquilado">
      <mat-card-content>
        <div class="card-icon-wrapper">
          <mat-icon>sell</mat-icon>
        </div>
        <div class="card-info">
          <span class="stat-label">En Alquiler</span>
          <h2 class="stat-value">{{ stats.alquilados || 0 }}</h2>
        </div>
      </mat-card-content>
    </mat-card>
  </section>

  <div class="dashboard-split-layout">
    
    <section class="chart-section">
      <mat-card class="dashboard-card main-chart">
        <mat-card-content>
          <apx-chart
            [series]="chartSeries"
            [chart]="chartDetails"
            [xaxis]="chartXAxis"
            [yaxis]="chartYAxis"
            [title]="chartTitle"
            [colors]="chartColors"
            [plotOptions]="chartPlotOptions"
            [dataLabels]="chartDataLabels"
            [grid]="chartGrid"
            [states]="chartStates">
          </apx-chart>
        </mat-card-content>
      </mat-card>
    </section>

    <aside class="sidebar-intelligence">
      
      <mat-card class="dashboard-card space-bottom">
        <div class="sidebar-header">
          <h3>Últimos Alquileres</h3>
          <span class="badge-info">Actividad</span>
        </div>
        
        <div class="sidebar-content">
          <div *ngIf="recentReservations.length === 0" class="no-data">
            No se registran alquileres recientes.
          </div>
          
          <div class="reservation-list" *ngIf="recentReservations.length > 0">
            <div class="reservation-item" *ngFor="let item of recentReservations">
              <div class="item-avatar">
                <mat-icon>person</mat-icon>
