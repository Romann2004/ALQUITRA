@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

.dashboard-container {
  padding: 32px;
  background-color: #f8fafc;
  font-family: 'Plus Jakarta Sans', sans-serif;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Cabecera Principal */
.dashboard-header { 
  margin-bottom: 32px; 
}
.dashboard-header h1 {
  font-size: 2.25rem;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 6px 0;
  letter-spacing: -0.025em;
}
.dashboard-header .subtitle { 
  font-size: 1rem; 
  color: #64748b; 
  margin: 0; 
}

/* Grilla de Tarjetas Métricas */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 24px;
  margin-bottom: 32px;
}
.stat-card {
  border-radius: 16px !important;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05) !important;
  background-color: #ffffff;
  transition: transform 0.2s ease;
}
.stat-card:hover { 
  transform: translateY(-4px); 
}
mat-card-content { 
  display: flex; 
  align-items: center; 
  padding: 24px !important; 
  gap: 20px; 
}
.card-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 12px;
}
mat-icon { font-size: 28px; width: 28px; height: 28px; }
.card-info { display: flex; flex-direction: column; }
.stat-label { font-size: 0.875rem; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
.stat-value { font-size: 2rem; font-weight: 800; color: #0f172a; margin: 0; line-height: 1.1; }

.total .card-icon-wrapper { background-color: #f1f5f9; }
.total mat-icon { color: #475569; }
.disponible .card-icon-wrapper { background-color: #f0fdf4; }
.disponible mat-icon { color: #16a34a; }
.alquilado .card-icon-wrapper { background-color: #eef2ff; }
.alquilado mat-icon { color: #4f46e5; }

/* Estructura Split (Dos Columnas Asimétricas) */
.dashboard-split-layout {
  display: grid;
  grid-template-columns: 1.5fr 1.1fr;
  gap: 24px;
  align-items: start;
}
@media (max-width: 1024px) {
  .dashboard-split-layout { grid-template-columns: 1fr; }
}

.dashboard-card {
  border-radius: 16px !important;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05) !important;
  background-color: #ffffff;
  padding: 24px;
}
.main-chart mat-card-content { 
  display: block; 
  padding: 8px 0 0 0 !important; 
}
.space-bottom { 
  margin-bottom: 24px; 
}

/* Encabezados de Paneles Laterales */
.sidebar-header { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  margin-bottom: 18px; 
  border-bottom: 1px solid #f1f5f9; 
