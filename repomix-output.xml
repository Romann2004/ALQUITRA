        <mat-form-field appearance="outline">
          <mat-label>Email</mat-label>
          <input matInput formControlName="email" type="email">
        </mat-form-field>
        
        <br>
        <div class="form-actions">
          <button mat-raised-button color="primary" type="submit" [disabled]="clienteForm.invalid" class="btn-accion">
            <mat-icon>{{ modoEdicion ? 'sync' : 'save' }}</mat-icon>
            {{ modoEdicion ? 'Actualizar' : 'Guardar Cliente' }}
          </button>
          
          <button mat-stroked-button type="button" *ngIf="modoEdicion" (click)="cancelarEdicion()" color="warn" class="btn-cancelar">
            <mat-icon>close</mat-icon>
            Cancelar
          </button>
        </div>

      </form>
    </mat-card-content>
  </mat-card>
  <div *ngIf="listClientes && listClientes.length >= 0; else cargando">
    <table mat-table [dataSource]="listClientes" class="mat-elevation-z8" style="width: 100%;">
      
      <ng-container matColumnDef="id">
        <th mat-header-cell *matHeaderCellDef> ID </th>
        <td mat-cell *matCellDef="let element"> {{element.id}} </td>
      </ng-container>

      <ng-container matColumnDef="nombre">
        <th mat-header-cell *matHeaderCellDef> Nombre </th>
        <td mat-cell *matCellDef="let element">
          <span (dblclick)="element.editNombre = true" *ngIf="!element.editNombre">
            {{element.nombre}}
          </span>
          <input *ngIf="element.editNombre"
                 [(ngModel)]="element.nombre"
                 (keyup.enter)="guardarCambio(element, 'nombre')"
                 (blur)="guardarCambio(element, 'nombre')"
                 class="edit-input">
        </td>
      </ng-container>

      <ng-container matColumnDef="dni">
        <th mat-header-cell *matHeaderCellDef> DNI </th>
        <td mat-cell *matCellDef="let element">
          <span (dblclick)="element.editDni = true" *ngIf="!element.editDni">
            {{element.dni}}
          </span>
          <input *ngIf="element.editDni"
                 [(ngModel)]="element.dni"
                 (keyup.enter)="guardarCambio(element, 'dni')"
                 (blur)="guardarCambio(element, 'dni')"
                 class="edit-input">
        </td>
      </ng-container>

      <ng-container matColumnDef="telefono">
        <th mat-header-cell *matHeaderCellDef> Teléfono </th>
        <td mat-cell *matCellDef="let element">
          <span (dblclick)="element.editTelefono = true" *ngIf="!element.editTelefono">
            {{element.telefono}}
          </span>
          <input *ngIf="element.editTelefono"
                 [(ngModel)]="element.telefono"
                 (keyup.enter)="guardarCambio(element, 'telefono')"
                 (blur)="guardarCambio(element, 'telefono')"
                 class="edit-input">
        </td>
      </ng-container>

      <ng-container matColumnDef="email">
        <th mat-header-cell *matHeaderCellDef> Email </th>
        <td mat-cell *matCellDef="let element">
          <span (dblclick)="element.editEmail = true" *ngIf="!element.editEmail">
            {{element.email}}
          </span>
          <input *ngIf="element.editEmail"
                 [(ngModel)]="element.email"
                 (keyup.enter)="guardarCambio(element, 'email')"
                 (blur)="guardarCambio(element, 'email')"
                 class="edit-input">
        </td>
      </ng-container>

      <ng-container matColumnDef="acciones">
        <th mat-header-cell *matHeaderCellDef> Acciones </th>
        <td mat-cell *matCellDef="let element">
          <button mat-icon-button color="blue" (click)="editarCliente(element)">
            <mat-icon>edit</mat-icon>
          </button>
          <button mat-icon-button color="warn" (click)="eliminarCliente(element.id)">
            <mat-icon>delete</mat-icon>
          </button>
        </td>
      </ng-container>

      <tr mat-header-row *matHeaderRowDef="displayedColumns"></tr>
      <tr mat-row *matRowDef="let row; columns: displayedColumns"></tr>
    </table>
  </div>
  <ng-template #cargando>
    <p>Conectando con el servidor o no hay clientes registrados...</p>
  </ng-template>
</div>
