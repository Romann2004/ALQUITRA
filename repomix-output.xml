      const errorFechas = validarFechas(fechaRetiro, fechaDevolucion, false);
      if (errorFechas) return res.status(400).json({ msg: errorFechas });

      const errorSuperposicion = await validarSuperposicionGrupal(
        trajeId || oldTrajeId, 
